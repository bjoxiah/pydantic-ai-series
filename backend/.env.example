# AI & tooling
OPEN_ROUTER_API_KEY=sk-or-v1-...
CONTEXT7_API_KEY=ctx7sk-...
LOG_FIRE_TOKEN=pylf_v1_us_...

# E2B cloud sandbox
E2B_API_KEY=e2b_...

# Kinde auth (used client-side in frontend — no backend env needed)
# Configure via frontend/.env.local

# Infrastructure (defaults work with docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
REDIS_URL=redis://localhost:6379
TEMPORAL_URL=localhost:7233

# Token encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here
